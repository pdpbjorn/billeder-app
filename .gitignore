# ------------------------------------------------------------
# billeder compromise policy
# ------------------------------------------------------------

# Source index (generated, never commit)
data/source/images.json

# Generated datasets (large, never commit)
data/tid/*.geo.json
data/sted/*.geo.json
data/anvendelse/*.geo.json
data/problems/*.geo.json

# Other geojson variants
data/tid/*.geojson
data/sted/*.geojson
data/anvendelse/*.geojson
data/problems/*.geojson

# Ignore raw per-folder json outputs (except indexes)
data/tid/*.json
data/sted/*.json
data/anvendelse/*.json
data/problems/*.json

# Keep only index.json in those folders
!data/tid/index.json
!data/sted/index.json
!data/anvendelse/index.json
!data/problems/index.json

# Keep the canonical "world countries" reference file (tracked)
!data/sted/world.total.modified.geo.json

# Reports: keep them (timestamped build reports go here)
# (No ignore rules for reports/)
